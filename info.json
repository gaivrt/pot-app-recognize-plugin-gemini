{
  "id": "plugin.io.github.gaivrt.gemini-ocr",
  "plugin_type": "recognize",
  "icon": "gemini.svg",
  "display": "Gemini OCR",
  "homepage": "https://github.com/gaivrt/pot-app-recognize-plugin-gemini",
  "version": "0.3.0", 
  "description": "Performs OCR using Google's Gemini models. Allows selecting common models or specifying a custom one.", 
  "needs": [
    {
      "key": "apiKey",
      "display": "Google AI API Key",
      "type": "input"
    },
    {
      "key": "modelSelection", 
      "display": "Common Gemini Model",
      "type": "select",
      "options": {
        "gemini-2.0-flash": "Gemini 2.0 Flash",
        "gemini-2.0-flash-lite": "Gemini 2.0 Flash Lite", 
        "": "--- Use Custom Model Below ---" 
      }
    },
    {
      "key": "customModelName", 
      "display": "Custom Model Name (Overrides Selection)",
      "type": "input",
      "placeholder": "e.g., gemini-2.0-flash (leave blank to use selection above)" 
    },
    {
      "key": "customPrompt",
      "display": "Custom OCR Prompt (Optional)",
      "type": "input",
      "placeholder": "Default: Extract text from this image."
    }
  ],
  "language": {
    "auto": "auto",
    "zh_cn": "zh-CN",
    "zh_tw": "zh-TW",
    "en": "en",
    "ja": "ja",
    "ko": "ko",
    "fr": "fr",
    "es": "es",
    "ru": "ru",
    "de": "de",
    "it": "it",
    "tr": "tr",
    "pt_pt": "pt-PT",
    "pt_br": "pt-BR",
    "vi": "vi",
    "th": "th",
    "ar": "ar",
    "hi": "hi",
    "fa": "fa"
  }
}